        "Slide 2: Big stat (e.g., avg price)",
        "Slide 3: Supporting stat with chart",
        "Slide 4: Another stat with meaning",
        "Slide 5: CTA + agent headshot"
      ],
      "content": {
        "kicker": "[GREG FILLS IN: e.g., 'Q3 2024 Update']",
        "headline": { "value": "[GREG: e.g., '$485,000']", "label": "[GREG: e.g., 'Average Selling Price']" },
