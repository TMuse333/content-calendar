  "entropyFramework": {
    "description": "Content should reduce uncertainty at the right level. Carousels work best at L3, L5, L6.",
    "levels": {
      "L1": { "name": "Identity", "question": "Who are you?", "tone": "professional, established" },
      "L2": { "name": "Offer", "question": "Is this for me?", "tone": "inviting, clear" },
      "L3": { "name": "Process", "question": "What are the steps?", "tone": "clear, step-by-step, demystifying", "carouselSweetSpot": true },
      "L4": { "name": "Proof", "question": "Can I trust you?", "tone": "trustworthy, proven" },
      "L5": { "name": "Expertise", "question": "What do I need to know?", "tone": "authoritative, detailed, insider", "carouselSweetSpot": true },
      "L6": { "name": "Situations", "question": "What if X happens?", "tone": "empathetic, reassuring, specific", "carouselSweetSpot": true },
      "L7": { "name": "Personality", "question": "What's it like working with you?", "tone": "warm, personal, authentic" }
    }
  },

  "designGuidance": {
    "hooks": [
      "Most people think [myth]. Here's the truth.",
      "What actually happens when you [process]",
      "The question I get asked most",
      "What if [scenario]?",
      "[X] steps to [outcome]"
    ],
    "literaryDevices": [
      "contrast (myth vs fact, before vs after)",
      "rule of three",
      "open loop (create curiosity)",
      "specificity (exact numbers, real examples)",
      "social proof (testimonials, stats)"
    ],
    "visualRules": [
      "Navy (#0a1628) for dark frames, Paper (#f8f6f1) for light",
      "Large, bold numbers for stats",
      "Greg's headshot on final slide",
      "RE/MAX logo subtle but present",
      "1080x1350 Instagram carousel size"
    ]
  },

